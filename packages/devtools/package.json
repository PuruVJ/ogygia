{
	"name": "@ogygia/devtools",
	"version": "0.11.0",
	"description": "Devtools for ogygia: the in-page dock, and the SSR profiler with its report, client marks and storage adapters",
	"type": "module",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"homepage": "https://ogygia.puruvj.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/devtools"
	},
	"keywords": ["ogygia", "sveltekit", "devtools", "profiler", "performance"],
	"exports": {
		".": {
			"types": "./dist/devtools/index.d.ts",
			"svelte": "./src/devtools/index.ts",
			"default": "./src/devtools/index.ts"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./src/vite.ts"
		},
		"./report": {
			"types": "./dist/report.d.ts",
			"default": "./dist/report.js"
		},
		"./profiler": {
			"types": "./dist/profiler/span.d.ts",
			"default": "./src/profiler/span.ts"
		},
		"./profiler/client": {
			"types": "./dist/profiler/client.d.ts",
			"default": "./src/profiler/client.ts"
		},
		"./profiler/storage": {
			"types": "./dist/profiler/storage/index.d.ts",
			"default": "./src/profiler/storage/index.ts"
		},
		"./profiler/storage/sqlite": {
			"types": "./dist/profiler/storage/sqlite.d.ts",
			"default": "./src/profiler/storage/sqlite.ts"
		},
		"./profiler/storage/redis": {
			"types": "./dist/profiler/storage/redis.d.ts",
			"default": "./src/profiler/storage/redis.ts"
		},
		"./profiler/storage/postgres": {
			"types": "./dist/profiler/storage/postgres.d.ts",
			"default": "./src/profiler/storage/postgres.ts"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "tsdown",
		"check": "tsc -p . && tsc -p e2e && vitest run",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@neodrag/svelte": "catalog:",
		"devalue": "catalog:"
	},
	"peerDependencies": {
		"@ogygia/router": "workspace:^",
		"@sveltejs/kit": "catalog:peers",
		"@ogygia/core": "workspace:^",
		"svelte": "catalog:peers",
		"vite": "catalog:peers"
	},
	"peerDependenciesMeta": {
		"@ogygia/router": {
			"optional": true
		}
	},
	"devDependencies": {
		"@ogygia/router": "workspace:*",
		"@ogygia/tooling": "workspace:*",
		"@ogygia/tsdown-plugin-svelte": "workspace:*",
		"@playwright/test": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"@ogygia/core": "workspace:*",
		"svelte": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/devtools/index.d.ts",
				"svelte": "./dist/devtools/index.js",
				"default": "./dist/devtools/index.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			},
			"./report": {
				"types": "./dist/report.d.ts",
				"default": "./dist/report.js"
			},
			"./profiler": {
				"types": "./dist/profiler/span.d.ts",
				"default": "./dist/profiler/span.js"
			},
			"./profiler/client": {
				"types": "./dist/profiler/client.d.ts",
				"default": "./dist/profiler/client.js"
			},
			"./profiler/storage": {
				"types": "./dist/profiler/storage/index.d.ts",
				"default": "./dist/profiler/storage/index.js"
			},
			"./profiler/storage/sqlite": {
				"types": "./dist/profiler/storage/sqlite.d.ts",
				"default": "./dist/profiler/storage/sqlite.js"
			},
			"./profiler/storage/redis": {
				"types": "./dist/profiler/storage/redis.d.ts",
				"default": "./dist/profiler/storage/redis.js"
			},
			"./profiler/storage/postgres": {
				"types": "./dist/profiler/storage/postgres.d.ts",
				"default": "./dist/profiler/storage/postgres.js"
			}
		}
	}
}
