{
	"name": "@ogygia/freeze",
	"version": "0.10.2",
	"private": true,
	"description": "Frozen pages for ogygia: a page whose render read nothing personal is stored once and served as bytes",
	"keywords": [
		"cache",
		"cdn",
		"esi",
		"ogygia",
		"sveltekit"
	],
	"homepage": "https://ogygia.puruvj.dev",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/freeze"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./src/vite.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc -p . && tsc -p test && tsc -p e2e && vitest run",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"devDependencies": {
		"@ogygia/core": "workspace:*",
		"@ogygia/flags": "workspace:*",
		"@ogygia/router": "workspace:*",
		"@ogygia/tooling": "workspace:*",
		"@playwright/test": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@ogygia/core": "workspace:^"
	}
}
