{
	"name": "@ogygia/testing",
	"version": "0.10.2",
	"description": "Testing for ogygia: the devtools and the profiler as test primitives, for Playwright or any runner and page driver",
	"keywords": [
		"ogygia",
		"performance",
		"playwright",
		"sveltekit",
		"testing",
		"web-vitals"
	],
	"homepage": "https://ogygia.puruvj.dev",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/testing"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc -p . && tsc -p test && tsc -p e2e && vitest run",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"devDependencies": {
		"@ogygia/core": "workspace:*",
		"@ogygia/devtools": "workspace:*",
		"@ogygia/tooling": "workspace:*",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@ogygia/core": "workspace:^",
		"@playwright/test": "catalog:peers"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		}
	}
}
