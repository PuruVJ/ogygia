{
	"name": "@ogygia/tsdown-plugin-svelte",
	"version": "1.0.1",
	"description": "Ship Svelte components from a tsdown build: preprocessed, TypeScript-free markup, with .svelte.d.ts types",
	"keywords": [
		"library",
		"plugin",
		"rolldown",
		"svelte",
		"tsdown"
	],
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/tsdown-plugin-svelte"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build && vitest run"
	},
	"dependencies": {
		"magic-string": "^1.1.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"svelte": "catalog:",
		"svelte2tsx": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@sveltejs/vite-plugin-svelte": ">=5.0.0",
		"svelte": "^5.40.0",
		"svelte2tsx": ">=0.7.0",
		"tsdown": ">=0.15.0",
		"typescript": ">=5.0.0"
	},
	"peerDependenciesMeta": {
		"@sveltejs/vite-plugin-svelte": {
			"optional": true
		},
		"svelte2tsx": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	}
}
