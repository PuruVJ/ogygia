{
	"name": "@ogygia/flags",
	"version": "0.10.2",
	"description": "Feature flags and A/B tests for ogygia: one flag() primitive, decided server-side, zero JS",
	"type": "module",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"homepage": "https://ogygia.puruvj.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/flags"
	},
	"keywords": ["ogygia", "sveltekit", "feature-flags", "ab-testing", "openfeature"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./src/index.ts"
		},
		"./openfeature": {
			"types": "./dist/openfeature.d.ts",
			"default": "./src/openfeature.ts"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./src/vite.ts"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "tsdown",
		"check": "tsc -p . && tsc -p test && vitest run",
		"test": "vitest run"
	},
	"dependencies": {
		"esm-env": "catalog:"
	},
	"peerDependencies": {
		"@ogygia/core": "workspace:^"
	},
	"devDependencies": {
		"@ogygia/tooling": "workspace:*",
		"@ogygia/core": "workspace:*",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./openfeature": {
				"types": "./dist/openfeature.d.ts",
				"default": "./dist/openfeature.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			}
		}
	}
}
