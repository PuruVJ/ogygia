	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:node": "vitest run --project node",
		"test:browser": "vitest run --project browser",
		"check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.check.json --fail-on-warnings && tsc -p test && vitest run",
		"prepublishOnly": "pnpm run build && pnpm run verify:package",
		"verify:package": "node scripts/verify-package.ts"
	},
	"dependencies": {
		"devalue": "catalog:",
		"esm-env": "catalog:",
		"estree-walker": "^3.0.3",
