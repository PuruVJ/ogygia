{
	"name": "@ogygia/router",
	"version": "0.10.2",
	"description": "The server router for ogygia: Kit's routing model as values (routes, layouts, loads, actions, endpoints, streamed pages), with a typed fetch client",
	"keywords": [
		"ogygia",
		"router",
		"routing",
		"server",
		"sveltekit"
	],
	"homepage": "https://ogygia.puruvj.dev",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/router"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./api": {
			"types": "./dist/client-api.d.ts",
			"default": "./src/client-api.ts"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./src/vite.ts"
		}
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./api": {
				"types": "./dist/client-api.d.ts",
				"default": "./dist/client-api.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			}
		},
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc -p . && svelte-check --tsconfig ./tsconfig.check.json --fail-on-warnings && tsc -p test && tsc -p e2e && vitest run",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"devDependencies": {
		"@ogygia/core": "workspace:*",
		"@ogygia/tooling": "workspace:*",
		"@playwright/test": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@ogygia/core": "workspace:^",
		"@sveltejs/kit": "catalog:peers",
		"svelte": "catalog:peers"
	}
}
