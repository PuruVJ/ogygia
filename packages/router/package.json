{
	"name": "@ogygia/router",
	"private": true,
	"version": "0.10.2",
	"description": "The server router for ogygia: Kit's routing model as values (routes, layouts, loads, actions, endpoints, streamed pages), with a typed fetch client",
	"type": "module",
	"license": "MIT",
	"author": "Puru Vijayvargia <devpuruvj@gmail.com>",
	"homepage": "https://ogygia.puruvj.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ogygiajs/ogygia.git",
		"directory": "packages/router"
	},
	"keywords": ["ogygia", "sveltekit", "router", "routing", "server"],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./api": {
			"types": "./dist/client-api.d.ts",
			"default": "./src/client-api.ts"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "tsdown",
		"check": "tsc -p . && vitest run",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@sveltejs/kit": ">=2.70.2 <4",
		"ogygia": "workspace:^",
		"svelte": "^5.56.8"
	},
	"devDependencies": {
		"@ogygia/tooling": "workspace:*",
		"@sveltejs/kit": "^2.70.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.1.2",
		"ogygia": "workspace:*",
		"svelte": "5.56.8",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.10"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./api": {
				"types": "./dist/client-api.d.ts",
				"default": "./dist/client-api.js"
			},
			"./vite": {
				"types": "./dist/vite.d.ts",
				"default": "./dist/vite.js"
			}
		}
	}
}
