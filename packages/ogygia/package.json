		"test": "vitest run",
		"lint": "oxlint -c .oxlintrc.json src",
		"check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json && vitest run && pnpm run lint",
		"prepublishOnly": "pnpm run build && pnpm run verify:package",
		"verify:package": "node scripts/verify-package.mjs"
	},
	"dependencies": {
		"devalue": "^5.9.0",
		"esm-env": "^1.2.2",
