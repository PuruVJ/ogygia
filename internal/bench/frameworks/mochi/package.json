{
	"name": "mochi-bench",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"sync": "node ../../shared/sync.ts mochi",
		"prebuild": "node ../../shared/sync.ts mochi",
		"build": "mochi-framework build",
		"start": "bun src/index.ts",
		"dev": "MODE=development bun src/index.ts",
		"clean": "rm -rf .mochi"
	},
	"dependencies": {
		"mdsvex": "0.12.8",
		"mochi-framework": "0.9.1",
		"rehype-slug": "6.0.0",
		"svelte": "5.56.8"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "5.9.3"
	},
	"overrides": {
		"msgpackr-extract": "npm:@mochi-framework/msgpackr-extract-stub@*"
	}
}
