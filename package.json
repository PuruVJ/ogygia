{
	"name": "ogygia-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"build:lib": "turbo run build --filter=./packages/*",
		"build": "pnpm run build:lib && pnpm --filter playground build",
		"build:docs": "pnpm run build:lib && pnpm --filter docs build",
		"dev": "pnpm run build:lib && pnpm --filter playground dev",
		"dev:docs": "pnpm run build:lib && pnpm --filter docs dev",
		"docs:dev": "pnpm run build:lib && pnpm --filter docs dev",
		"preview": "pnpm --filter playground preview",
		"preview:docs": "pnpm --filter docs preview",
		"check:lib": "turbo run check --filter=./packages/*",
		"check:playground": "turbo run check --filter=playground",
		"check:docs": "turbo run check --filter=docs",
		"check:verify": "tsc --noEmit -p e2e/tsconfig.json",
		"test:e2e": "playwright test",
		"test:e2e:fast": "E2E_NO_BUILD=1 playwright test",
		"check": "turbo run check --filter=./packages/* --filter=playground && pnpm run check:verify",
		"test:adapters": "playwright test adapters",
		"demo:esi": "node e2e/demo/esi.ts",
		"e2e": "playwright test",
		"bundle-size": "node e2e/bundle-size.ts",
		"bench": "node internal/bench/build-all.ts && node internal/bench/benchmark.ts --config frameworks.config.json --out results/latest.md --json",
		"bench:build": "node internal/bench/build-all.ts",
		"bench:run": "node internal/bench/benchmark.ts --config frameworks.config.json --out results/latest.md --json",
		"profiler:answer-key": "node internal/bench/profiler-answer-key.ts --serve --build",
		"profiler:answer-key:no-maps": "node internal/bench/profiler-answer-key.ts --serve --build --no-maps",
		"changeset": "changeset",
		"ci:version": "changeset version",
		"ci:release": "changeset publish",
		"format": "oxfmt packages/core/src packages/core/test",
		"format:check": "oxfmt --check packages/core/src packages/core/test"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@playwright/test": "1.62.1",
		"@types/node": "^26.1.2",
		"axe-core": "^4.13.0",
		"oxfmt": "^0.64.0",
		"playwright": "^1.62.1",
		"rolldown": "^1.2.2",
		"turbo": "^2.11.10",
		"typescript": "^7.0.2"
	}
}
